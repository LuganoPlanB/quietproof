@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(LongfellowZK CONFIG REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/LongfellowZKQuietProofTargets.cmake")
foreach(_quietproof_component IN LISTS LongfellowZKQuietProof_FIND_COMPONENTS)
  set(LongfellowZKQuietProof_${_quietproof_component}_FOUND FALSE)
  if(_quietproof_component STREQUAL "rpc")
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/LongfellowZKQuietProofRpcTargets.cmake")
      find_dependency(CURL 7.62)
      include("${CMAKE_CURRENT_LIST_DIR}/LongfellowZKQuietProofRpcTargets.cmake")
      set(LongfellowZKQuietProof_rpc_FOUND TRUE)
    else()
      set(LongfellowZKQuietProof_NOT_FOUND_MESSAGE
        "The installed LongfellowZKQuietProof package was built without the rpc component")
    endif()
  endif()
endforeach()
unset(_quietproof_component)
check_required_components(LongfellowZKQuietProof)
